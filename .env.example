# All variables are optional. Without them the console uses the public RPC
# endpoints listed in app/rpc-config.ts.

# Browser RPCs (inlined at build time, comma-separated)
#NEXT_PUBLIC_MAINNET_RPC_URLS=https://ethereum.publicnode.com,https://eth.llamarpc.com
#NEXT_PUBLIC_HOODI_RPC_URLS=https://rpc.hoodi.ethpandaops.io,https://hoodi.drpc.org

# Report API RPCs (read at runtime, comma-separated). They must serve
# eth_getLogs over 10k-block ranges for about 35 days of history.
#MAINNET_RPC_URLS=https://rpc.mevblocker.io,https://gateway.tenderly.co/public/mainnet
#HOODI_RPC_URLS=https://rpc.hoodi.ethpandaops.io

# Optional Etherscan API key (v2). When set, the report API also lists the
# receivers' direct and internal transactions from Etherscan.
#ETHERSCAN_API_KEY=

# HTTP port of the production server
#PORT=3000
